<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- iOS needs Xcode, so it is only offered on macOS. Without the condition these
         projects cannot be evaluated at all on the Linux runner that the Android
         tests use. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios26.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>NUnitTests</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>NUnitTests</ApplicationTitle>
    <ApplicationId>com.companyname.nunittests</ApplicationId>
    <ApplicationIdGuid>d32b68f1-3629-4754-86cf-d02986b4d1aa</ApplicationIdGuid>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
  </PropertyGroup>
  <!--
    Set by the build script's Test target. It makes the app run its tests and exit on its own,
    which is how the automated run knows the suite has finished. Left off for ordinary builds
    so the app stays open when launched from an IDE.
  -->
  <PropertyGroup Condition="'$(AutomatedTestRun)' == 'true'">
    <DefineConstants>$(DefineConstants);AUTOMATED_TEST_RUN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!--
      The iOS SDK requires the installed Xcode's major.minor to exactly equal the version its
      workload recommends, and errors out otherwise. We pin the iOS binding to 26.0 (above),
      which the installed Xcode's iOS SDK satisfies, so the build itself is sound and only the
      equality check needs relaxing. Drop this once the installed Xcode matches the recommended
      version for the installed iOS workload.
    -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\framework\nunit.framework.csproj" />
    <ProjectReference Include="..\NUnit.Maui.Runner\NUnit.Maui.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>